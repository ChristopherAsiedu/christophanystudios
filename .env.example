# Required for live enquiry email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=Christophany Studios <bookings@your-verified-domain.com>
NEXT_PUBLIC_SITE_URL=

# Optional: only loaded after the visitor opts into analytics
NEXT_PUBLIC_GA_ID=

# MySQL storage for enquiries (table is created automatically). Use DATABASE_URL or the MYSQL_* values.
DATABASE_URL=
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# Password for the /admin enquiries page (required to enable it). Optionally set a separate session-signing secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
